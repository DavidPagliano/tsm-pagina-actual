              "font-weight": "900",
              "border": "2px dashed @activeTabColor1",
              "border-radius": "25px !important",
              "transition": "all .3s",
              "text-align": "center",
              "flex-direction": "column",
              "&:hover": {
                "background-color": "transparent",
                "color": "@warningColor"
              },
              "&.active": {
                "color": "contrast(@warningColor, darken(@warningColor, 50%), #ffffff, 60%)",
                "background": "@activeTabColor1"
              }
            },
            ".icon-img": {
              "display": "inline-block",
              "vertical-align": "middle",
              "width": "40px",
              "height": "40px"
            },
            ".wrapper": {
