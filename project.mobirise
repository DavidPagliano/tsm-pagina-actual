                "margin-top": "0.4rem"
              }
            },
            ".mbr-section-title": {
              "color": "#0a1c44"
            }
          },
          "_customHTML": "<section class=\"tabs3 kidsm4_tabs3 tabs\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" group=\"Accordion & Toggles & Tabs\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input inline max=\"15\" min=\"0\" name=\"paddingTop\" step=\"1\" title=\"Top\" type=\"range\" value=\"6\">\n\t\t<input inline max=\"15\" min=\"0\" name=\"paddingBottom\" step=\"1\" title=\"Bottom\" type=\"range\" value=\"5\">\n\t\t<header>Show/Hide</header>\n\t\t<input name=\"showTitle\" title=\"Title\" type=\"checkbox\" checked>\n\t\t<input name=\"showSubtitle\" title=\"Subtitle\" type=\"checkbox\" checked>\n\t\t<header>Tab</header>\n\t\t<select name=\"bootstrapTabs\" title=\"Tabs Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t</select> <input name=\"tabColor\" title=\"Tab Color\" type=\"color\" value=\"#f4f8fa\">\n\t\t<input name=\"activeTabColor1\" title=\"Active Tab Color\" type=\"color\" value=\"#145b2c\">\n\t\t<input name=\"ColorBG\" title=\"Background\" type=\"color\" value=\"#ffffff\">\n\t\t<input checked name=\"showTitleTab\" title=\"Title\" type=\"checkbox\">\n\t\t<input checked name=\"showImages\" title=\"Image\" type=\"checkbox\">\n\t\t<select name=\"itemsCount\" title=\"Items Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset name=\"bg\" parallax type=\"background\">\n\t\t\t<input parallax title=\"Image\" type=\"image\" value>\n\t\t\t<input selected title=\"Color\" type=\"color\" value=\"#ffffff\">\n\t\t\t<input title=\"Video\" type=\"video\" value=\"https://vimeo.com/201169087\">\n\t\t</fieldset>\n\t\t<input checked condition=\"bg.type=='color'\" name=\"gradientBg\" title=\"Gradient\" type=\"checkbox\">\n\t\t<input condition=\"gradientBg && bg.type == 'color'\" name=\"color2\" title=\"Color 2\" type=\"color\" value=\"#ffffff\">\n\n\t\t<input checked condition=\"bg.type !== 'color'\" name=\"overlay\" title=\"Overlay\" type=\"checkbox\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" name=\"overlayColor\" title=\"Overlay Color\" type=\"color\" value=\"#ffffff\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" inline max=\"1\" min=\"0\" name=\"overlayOpacity\" step=\"0.1\" title=\"Opacity\" type=\"range\" value=\"0.7\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<h2 class=\"mbr-section-title align-center mbr-fonts-style pb-3\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\"><b>\n\t\t\tNivel Primario</b></h2>\n\t\t<h3 class=\"mbr-section-subtitle align-center mbr-light mbr-fonts-style pb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\">\n\t\t\tEl Nivel Primario del CECIEMA abarca de 1° a 7° grado y se desarrolla en ambos turnos.</h3>\n\t\t<div class=\"media-container-row\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<ul class=\"nav nav-tabs\" data-app-placeholder=\"Type Title\" role=\"tablist\">\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab1-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style show active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-15_tab0\" role=\"tab\"><span class=\"mobi-mbri mobi-mbri-features mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Bloques&nbsp;</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 2\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab2-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-15_tab1\" role=\"tab\"><span class=\"mbri-windows mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Aulas</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 2\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab3-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-15_tab2\" role=\"tab\"><span class=\"mobi-mbri mobi-mbri-update mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Trabajo</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 3\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab4-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-15_tab3\" role=\"tab\"><span class=\"mobi-mbri mobi-mbri-responsive-2 mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">TIC</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item last-navitem\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 4\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab5-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-15_tab4\" role=\"tab\">\n\t\t\t\t\t\t\t<span class=\"mbrib-star mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t<span class=\"name\">Holidays</span> </a></li>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"tab-content\">\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab1\" class=\"tab-pane active\" id=\"kids3-tab1-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\t<br>Bloques Educativos</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><br>El Nivel Primario se organiza  por Bloques Educativos en los que se integran chicos de diferentes edades. Esto favorece la articulación entre ciclos y niveles educativos.<br><br>\n<br></p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Mayor articulación</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tIntegración de estudiantes</h4>\n\t\t\t\t\t\t\t\t\t</div><div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Más interacción&nbsp;</h4>\n\t\t\t\t\t\t\t\t\t</div></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/-dsc5616-998x665.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab2\" class=\"tab-pane\" id=\"kids3-tab2-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img card-img2\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/-dsc5646-998x665.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"right-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tAmbientes especializados</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tCuenta con aulas temáticas especializadas y equipadas para mejorar los procesos de enseñanza y aprendizaje, a través de un mejor aprovechamiento de los espacios y de los recursos didácticos y tecnológicos. </p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tAulas temáticas</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Materiales preparados</h4>\n\t\t\t\t\t\t\t\t\t</div><div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Recursos disponibles</h4>\n\t\t\t\t\t\t\t\t\t</div></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab3\" class=\"tab-pane\" id=\"kids3-tab3-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tTrabajo en Equipo</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tSe promueve el  trabajo en equipo, la interacción docente-alumno y el trabajo con las Inteligencias Múltiples.   </p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Trabajo Colaborativo</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tAutogestión</h4>\n\t\t\t\t\t\t\t\t\t</div><div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Proyectos-Clubes</h4>\n\t\t\t\t\t\t\t\t\t</div></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/-dsc5629-998x665.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab4\" class=\"tab-pane\" id=\"kids3-tab4-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tImplementación de TIC</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tSe implementan las TIC (Tecnologías de la Información y Comunicación) a través del Blog escolar \"Ceciema en la Red\", un espacio web en el que se  imparten clases online potenciando la información multimedial, hipertextual e interactiva. Los chicos aprenden a través de materiales audiovisuales, juegos, libros digitales diseñados por los docentes, e interactúan entre ellos y con el equipo docente a través de comentarios y preguntas </p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Internet en cada aula</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Recursos audiovisuales</h4>\n\t\t\t\t\t\t\t\t\t</div><div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Classroom y Blog escolar</h4>\n\t\t\t\t\t\t\t\t\t</div></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/img-20171018-155258-998x561.jpeg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab5\" class=\"tab-pane\" id=\"kids3-tab5-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet </h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit. Autem laudantium in adipisci ipsa optio quas id excepturi non, eos cupiditate </p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"false\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tOutdoor Activity </h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"false\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tOutdoor Activity </h4>\n\t\t\t\t\t\t\t\t\t</div><div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"false\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tOutdoor Activity </h4>\n\t\t\t\t\t\t\t\t\t</div></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/gallery06.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
