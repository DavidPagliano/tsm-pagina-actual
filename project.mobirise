              ".nav-item": {
                "display": "table-cell"
              }
            },
            ".card-img img": {
              "width": "100%",
              "border-radius": "30px"
            },
            ".tab-content": {
              "background-color": "@ColorBG",
              "border-radius": "30px"
            },
            ".nav-tabs .nav-link": {
              "display": "flex",
              "color": "@infoColor",
              "box-sizing": "border-box",
              "font-style": "normal",
              "background": "@tabColor",
              "font-weight": "900",
              "border": "2px dashed @activeTabColor1",
              "border-radius": "25px !important",
              "transition": "all .3s",
              "text-align": "center",
              "flex-direction": "column",
              "&:hover": {
                "background-color": "transparent",
                "color": "@warningColor"
              },
              "&.active": {
                "color": "contrast(@warningColor, darken(@warningColor, 50%), #ffffff, 60%)",
                "background": "@activeTabColor1"
              }
            },
            ".icon-img": {
              "display": "inline-block",
              "vertical-align": "middle",
              "width": "40px",
              "height": "40px"
            },
            ".wrapper": {
              "margin-bottom": "1.5rem"
            },
            ".card-title": {
              "color": "#12265a",
              "display": "inline-block",
              "vertical-align": "bottom",
              "margin-left": "1rem",
              "margin-bottom": "0"
            },
            ".container-fluid": {
              "max-width": "1200px"
            },
            ".row": {
              "align-items": "center"
            },
            ".title-content": {
              "color": "#145b2c"
            },
            ".name": {
              "margin-top": "1rem"
            },
            "@media (min-width: 992px)": {
              ".nav-tabs": {
                "margin-right": "auto",
                "margin-left": "auto"
              },
              ".nav-tabs .nav-link": {
                "margin": "0 1rem",
