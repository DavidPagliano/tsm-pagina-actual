              },
              ".tab-content": {
                "padding": "3.5rem"
              },
              ".left-column": {
                "padding-right": "4rem"
              },
              ".right-column": {
                "padding-left": "4rem"
              }
            },
            "@media (max-width: 991px)": {
              ".tab-content": {
                "padding": "1rem"
              },
              ".nav-item": {
                "padding": "0.5rem"
              },
              ".card-img": {
                "margin-top": "0.6rem"
              },
              ".card-img2": {
                "margin-bottom": "1.5rem"
              }
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".nav-tabs": {
                "padding": "0",
                "display": "flex",
                "justify-content": "space-between"
              },
              ".nav-item": {
                "padding": "0"
              },
              ".last-navitem": {
                "width": "100%"
              },
              "li": {
                "width": "140px"
              },
              ".container-fluid": {
                "padding": "0"
