          "_params": {}
        },
        {
          "_name": "tabs02",
          "_sourceTheme": "visionm4",
          "_customHTML": "<section class=\"tabs2\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" group=\"Tabs\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input inline max=\"9\" min=\"0\" name=\"paddingTop\" step=\"1\" title=\"Top\" type=\"range\" value=\"4\">\n        <input inline max=\"9\" min=\"0\" name=\"paddingBottom\" step=\"1\" title=\"Bottom\" type=\"range\" value=\"4\">\n        <header>Show/Hide</header>\n        <input name=\"showmainsubTitle\" title=\"Subtitle\" type=\"checkbox\">\n        <input checked name=\"showTitle\" title=\"Title\" type=\"checkbox\">\n        <input name=\"showLink\" title=\"Link\" type=\"checkbox\">\n        <select name=\"bootstrapTabs\" title=\"Tabs Count\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n        </select>\n        <header>Color</header>\n        <input condition=\"showmainsubTitle\" name=\"subtitle\" selected title=\"Subtitle BG\" type=\"color\" value=\"#e7e7fb\">\n        <input name=\"tabsColor\" title=\"Tabs\" type=\"color\" value=\"#777d74\">\n        <input name=\"activeTabColor\" title=\"Active Tab\" type=\"color\" value=\"#000000\">\n        <input name=\"tabsColor2\" title=\"Tabs Border\" type=\"color\" value=\"#f8f8f8\">\n        <input name=\"activeTabColor2\" title=\"Active Tab Border\" type=\"color\" value=\"#0a1c44\">\n        <input condition=\"showLink\" name=\"iconColor\" selected title=\"Link Icon\" type=\"color\" value=\"#1c1c25\">\n        <input condition=\"showLink\" name=\"iconColor1\" selected title=\"Icon BG\" type=\"color\" value=\"#a8aaf1\">\n        <header>Background</header>\n        <fieldset name=\"bg\" parallax type=\"background\">\n            <input parallax title=\"Image\" type=\"image\" value=\"../_images/background3.jpg\">\n            <input selected title=\"Color\" type=\"color\" value=\"#f5f7fa\">\n            <input title=\"Video\" type=\"video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input checked condition=\"bg.type !== 'color'\" name=\"overlay\" title=\"Overlay\" type=\"checkbox\">\n        <input condition=\"overlay&&bg.type !== 'color'\" name=\"overlayColor\" title=\"Overlay Color\" type=\"color\" value=\"#ffffff\">\n        <input condition=\"overlay&&bg.type !== 'color'\" inline max=\"1\" min=\"0\" name=\"overlayOpacity\" step=\"0.1\" title=\"Opacity\" type=\"range\" value=\"0.7\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div class=\"container\">\n\n        <div class=\"row\">\n            <div class=\"col-12 col-md-12 md-pb col-lg-6\">\n\n                <div class=\"align-wrapper align-left\">\n                    <h5 class=\"main-sub-title mbr-fonts-style mb-3\" data-app-selector=\".main-sub-title, .align-wrapper\" mbr-if=\"showmainsubTitle\" mbr-theme-style=\"display-4\">PHILOSOPHY</h5>\n                </div>\n\n                <h2 class=\"title align-left pb-3 mbr-fonts-style\" data-app-selector=\".title, .link-align-wrapper\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\">\n                    <b>Organización</b></h2>\n\n                <ul class=\"nav nav-tabs\" role=\"tablist\">\n                    <li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\" role=\"presentation\"><a aria-controls=\"vision2-tab1-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style show active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs02-2a_tab0\" role=\"tab\">Modelo Innovador</a></li>\n                    <li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 1\" mbr-theme-style=\"display-7\" role=\"presentation\">\n                        <a aria-controls=\"vision2-tab2-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#vision2-tab2-content\" id=\"vision2-tab2\" role=\"tab\"> Our Vision</a>\n                    </li>\n                    <li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 2\" mbr-theme-style=\"display-7\" role=\"presentation\">\n                        <a aria-controls=\"vision2-tab3-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#vision2-tab3-content\" id=\"vision2-tab3\" role=\"tab\"> Our Values</a>\n                    </li>\n                </ul>\n                <div class=\"tab-content\">\n                    <div aria-labelledby=\"vision2-tab1\" class=\"tab-pane active\" id=\"vision2-tab1-content\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">La carrera está organizada de manera que permite el Trabajo por Proyectos e Interdisciplinario, haciendo énfasis en el trabajo en equipo,  e integrando alumnos de los diferentes años en algunos espacios curriculares.<br>Se dedica tiempo a la Práctica con equipamiento donde se ponen en juego los conocimientos de todas las materias de la carrera.<br>Se realizan eventos anuales abiertos a la comunidad como los “Workshop Emprendedores Digitales” gestionados integramente por los estudiantes con la colaboración y guía de los profesores.&nbsp;<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-labelledby=\"vision2-tab2\" class=\"tab-pane\" id=\"vision2-tab2-content\" mbr-if=\"bootstrapTabs > 1\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Etiam eros dolor, suscipit ut diam ac, rhoncus luctus nisl. Sed consectetur egestas metus, vestibulum venenatis sapien tincidunt vitae. Sed mollis eros ac accumsan tempor. Proin mollis purus nec ligula venenatis, ut sagittis ex placerat. Sed purus felis, lobortis id elementum eu, suscipit at mauris. Phasellus a ipsum vel est ornare dignissim. Donec vel congue dui. Sed eu sapien massa.<br>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-labelledby=\"vision2-tab3\" class=\"tab-pane\" id=\"vision2-tab3-content\" mbr-if=\"bootstrapTabs > 2\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Quisque facilisis quis dolor at placerat. Mauris quis eros fermentum, interdum massa vel, pellentesque diam. Phasellus at molestie odio, eu convallis justo. In hac habitasse platea dictumst. Cras ac porta sem. Nulla aliquam orci dui, vel finibus nisi hendrerit ut. Phasellus fringilla libero quis risus auctor feugiat. Aenean sollicitudin eleifend hendrerit. Duis et rutrum velit.<br>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n\n                <div class=\"link-align-wrapper align-left\" mbr-if=\"showLink\">\n                    <div class=\"inline-wrapper\">\n                        <div class=\"link-wrapper mbr-flex\">\n                            <a class=\"iconfont-wrapper mbr-media show-modal\" data-target=\".w1\" data-toggle=\"modal\" href=\"#\">\n                                <span class=\"icon-bg icon1\"></span>\n                                <span class=\"p-2 mbr-iconfont mobi-mbri-arrow-next mobi-mbri\" mbr-icon></span> </a>\n\n                            <p class=\"link align-left mbr-fonts-style\" data-app-selector=\".link\" mbr-theme-style=\"display-4\">\n                                <a class=\"text-black\" href=\"#\"><b>Learn More</b></a><br></p>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-lg-5 col-md-12\">\n                <img alt=\"Mobirise\" src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2018-11-05-at-22.35.17-730x973.jpeg\" title>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            ".row": {
              "justify-content": "space-between"
            },
            "img": {
              "border-radius": "8px"
            },
            ".tab-content": {
              "margin-bottom": "1rem"
            },
            ".nav-tabs": {
              "-webkit-flex-wrap": "wrap",
              "flex-wrap": "wrap",
              "border": "0",
              ".nav-item": {
                "padding": "0.25rem 1rem"
              }
            },
            ".main-sub-title": {
              "background": "@subtitle",
              "border-radius": "8px",
              "display": "inline-block",
              "width": "fit-content",
              "padding": "0.1rem 1rem"
            },
            ".nav-tabs .nav-link": {
              "border-radius": "0 !important",
              "font-style": "normal",
              "font-weight": "500",
              "color": "@tabsColor !important",
              "transition": "all .5s",
              "&:hover": {
                "cursor": "pointer",
                "color": "@activeTabColor !important"
              },
              "&.active": {
                "font-weight": "500",
                "color": "@activeTabColor !important",
                "font-style": "normal"
              }
            },
            ".nav-link": {
              "border": "none",
              "border-bottom": "3px solid @tabsColor2 !important",
              "&:hover": {
                "border": "none",
                "border-bottom": "3px solid @activeTabColor2 !important"
              }
            },
            ".nav-link.active": {
              "border": "none",
              "border-bottom": "3px solid @activeTabColor2 !important"
            },
            "P": {
              "color": "#42424c"
            },
            "@media (max-width: 576px)": {
              ".nav-tabs": {
                "flex-direction": "column",
                "justify-content": "center"
              },
              ".mbr-text, .nav-link": {
                "text-align": "center"
              }
            },
            ".main-sub-title, .align-wrapper": {
              "color": "#33358c"
            },
            "z-index": "2\n",
            ".link-wrapper": {
              "align-items": "center",
              "display": "flex",
              "p": {
                "padding": "0",
                "margin": "0",
                "padding-left": "0.5rem"
              }
            },
            ".inline-wrapper": {
              "display": "inline-block"
            },
            ".align-wrapper": {
              "width": "100%"
            },
            ".iconfont-wrapper": {
              "position": "relative",
              "box-shadow": "0px 0px 0px 2px @iconColor inset",
              "border-radius": "4px",
              "min-width": "20px",
              "width": "20px",
              "align-items": "center",
              "display": "flex",
              "height": "20px",
              "margin": "0 0.4rem",
              "justify-content": "center",
              "transition": "all 0.3s",
              "&:hover": {
                ".icon-bg": {
                  "top": "0px",
                  "right": "0px"
                },
                ".mbr-iconfont": {
                  "color": "white"
                },
                "box-shadow": "0px 0px 0px 2px transparent inset"
              }
            },
            ".mbr-iconfont": {
              "z-index": "2",
              "transition": "all 0.3s",
              "font-size": ".5rem",
              "font-weight": "900",
              "color": "@iconColor"
            },
            ".icon-bg": {
              "position": "absolute",
              "overflow": "visible",
              "top": "3px",
              "right": "-3px",
              "box-sizing": "border-box",
              "width": "100%",
              "transition": "all 0.3s",
              "z-index": "-1",
              "height": "100%",
              "border-radius": "4px",
              "background": "@iconColor1"
            },
            ".title, .link-align-wrapper": {
              "color": "#0a1c44"
            }
          },
          "_cid": "tc3mrfdM4B",
          "_anchor": "tabs02-2a",
