          "_name": "menu1",
          "_sourceTheme": "educationm4",
          "_customHTML": "<section class=\"menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <select title=\"Widget Count\" name=\"widgetCount\">\n            <option value=\"0\" selected>0</option>\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n        </select>\n        <select title=\"Menu Align\" name=\"menuAlign\">\n            <option value=\"left\">Left</option>\n            <option value=\"center\">Center</option>\n            <option value=\"right\" selected>Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.5\" value=\"4\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#0a1c44\">\n        <input type=\"color\" title=\"Top Menu\" name=\"menutopColor\" value=\"#0a1c44\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#0a1c44\">\n        <input type=\"color\" title=\"Dropdown Border\" name=\"drbrColor\" value=\"#4f5b77\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\" mbr-if=\"widgetCount > 0\">\n\n\n\n            <div class=\"menu-content-right\">\n                <div class=\"info-widget\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mbri-mobile2\" style=\"color: rgb(158, 158, 158);\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">+ (123) 1800-567-8990</p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 1\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mbri-clock\" style=\"color: rgb(158, 158, 158);\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">Mon - Fri: 9:00AM - 5:00PM</p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 2\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mbri-letter\" style=\"color: rgb(158, 158, 158);\"></span>\n                    <div class=\"widget-content mbr-fonts-style\">\n                        <p class=\"widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">office@example.com</p>\n                    </div>\n                </div>\n\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 3\">\n                    <span mbr-icon class=\"widget-icon mbri-letter mbr-iconfont\"></span>\n                    <div class=\"widget-content mbr-fonts-style\">\n                        <p class=\"widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">office@example.com</p>\n                    </div>\n                </div>\n\n\n\n\n\n\n\n\n\n\n\n            </div>\n        </div>\n        <div class=\"menu-bottom\">\n\n\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/escudo-ceciema3-75x102.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-5\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a href=\"index.html\" class=\"brand-name mbr-black text-black mbr-bold text-primary\" data-app-selector=\".brand-name\" data-app-placeholder=\"Type Text\">Complejo Educativo Cristiano IEMA</a></span>\n                </div>\n            </div>\n\n\n\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Inicio</a>\n                    </li>\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link mbr-black dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Institucional</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"mbr-black dropdown-item text-black text-primary\" href=\"institucional.html#tabs1-b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Quiénes somos</a>\n                            <a class=\"mbr-black dropdown-item text-black text-primary\" href=\"institucional.html#tabs1-f\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Misión y Visión&nbsp;</a>\n                            <a class=\"mbr-black dropdown-item text-black text-primary\" href=\"institucional.html#tabs1-g\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Objetivos Institucionales</a><a class=\"mbr-black dropdown-item text-black text-primary\" href=\"institucional.html#tabs1-h\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Modelo Educativo</a><a class=\"mbr-black dropdown-item text-black text-primary\" href=\"institucional.html#timeline3-i\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Historia</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link mbr-black dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Niveles</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"mbr-black dropdown-item text-black text-primary\" href=\"inicial.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Nivel Inicial</a>\n                            <a class=\"mbr-black dropdown-item text-black text-primary\" href=\"primario.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Nivel Primario</a>\n                            <a class=\"mbr-black dropdown-item text-black text-primary\" href=\"secundario.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Nivel Secundario</a><a class=\"mbr-black dropdown-item text-black text-primary\" href=\"terciario.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Nivel Terciario</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"secretaria.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Secretaría</a>\n                    </li></ul>\n\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-md btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Acceder</a></div>\n\n            </div>\n            <button class=\"navbar-toggler \" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n\n\n\n\n\n\n\n        </div>\n    </nav>\n</section>",
          "_anchor": "menu1-3d",
          "_isUserblock": true,
          "_cid": "tnaOVcfETA",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-section-subtitle": {
              "font-family": "@display2Font",
              "font-weight": "900",
              "background-color": "lighten(@secondaryColor, 12%)",
              "padding": "0 1rem",
              "border-radius": "5px",
              "display": "inline-block"
            },
            ".mbr-text": {
              "margin-bottom": "1.3rem"
            },
            ".svg-1": {
              "position": "absolute",
              "bottom": "0"
            },
            ".svg-1 path": {
              "fill": "@LineColor"
            },
            ".container-fluid": {
              "max-width": "1200px"
            },
            ".mbr-arrow": {
              "z-index": "1"
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".mbr-text": {
                "color": "#343549"
              }
            },
            "@media (min-width: 768px)": {
              ".container-fluid": {
                "padding": "0 1.8rem"
              }
            }
          },
          "_name": "header1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section group=\"Header\" class=\"header1 kidsm4_header1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<select name=\"alignContent\" title=\"Align Content\">\n\t\t\t<option value=\"1\" selected>Left</option>\n\t\t\t<option value=\"2\">Center</option>\n\t\t\t<option value=\"3\">Right</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/-dsc5768-2000x1333.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\">\n\t\t</fieldset>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Line\" name=\"LineColor\" value=\"#ffffff\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-md-12 col-lg-12\" mbr-class=\"{'align-center' : alignContent == 2, 'align-right' : alignContent == 3}\">\n\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-white mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">¡Jóvenes en acción!</h3>\n\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Nivel Secundario</h1>\n\t\t\t\t<p class=\"mbr-text pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Pensar, razonar, argumentar, investigar, prepararse en todas las áreas,<br> desarrollando todo el potencial, con convicciones de fe y&nbsp;<br>vínculos sanos para aportar a la sociedad en que viven.<br><br></p>\n\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://sites.google.com/complejoiema.com.ar/expo-tecno-2022/p%C3%A1gina-principal\" data-app-placeholder=\"Type Text\" target=\"_blank\">Anuario 2022</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n\t\t<a href=\"#next\">\n\t\t\t<i class=\"mbri-down mbr-iconfont\"></i>\n\t\t</a>\n\t</div>\n\t<svg class=\"svg-1\" data-name=\"Layer 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1428.75 62.05\">\n\t\t<path class=\"cls-1\" d=\"M-114,132s185,44,434,18c0,0,304-41,551,0,0,0,290.5,57.25,443.75.13v43.69H-114Z\" transform=\"translate(114 -131.78)\"></path>\n\t</svg>\n</section>",
          "_cid": "tbYfKKKsWV",
          "_anchor": "header1-17",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "tabs3",
          "_sourceTheme": "kidsm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(0deg, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "left"
            },
            ".nav-tabs": {
              "margin-bottom": "1rem",
              "padding": "3px",
              "display": "table",
              "border-bottom": "none",
              ".nav-item": {
                "display": "table-cell"
              }
            },
            ".card-img img": {
              "width": "100%",
              "border-radius": "30px"
            },
            ".tab-content": {
              "background-color": "@ColorBG",
              "border-radius": "30px"
            },
            ".nav-tabs .nav-link": {
              "display": "flex",
              "color": "@infoColor",
              "box-sizing": "border-box",
              "font-style": "normal",
              "background": "@tabColor",
              "font-weight": "900",
              "border": "2px dashed @activeTabColor1",
              "border-radius": "25px !important",
              "transition": "all .3s",
              "text-align": "center",
              "flex-direction": "column",
              "&:hover": {
                "background-color": "transparent",
                "color": "@warningColor"
              },
              "&.active": {
                "color": "contrast(@warningColor, darken(@warningColor, 50%), #ffffff, 60%)",
                "background": "@activeTabColor1"
              }
            },
            ".icon-img": {
              "display": "inline-block",
              "vertical-align": "middle",
              "width": "40px",
              "height": "40px"
            },
            ".wrapper": {
              "margin-bottom": "1.5rem"
            },
            ".card-title": {
              "color": "#12265a",
              "display": "inline-block",
              "vertical-align": "bottom",
              "margin-left": "1rem",
              "margin-bottom": "0"
            },
            ".container-fluid": {
              "max-width": "1200px"
            },
            ".row": {
              "align-items": "center"
            },
            ".title-content": {
              "color": "#145b2c"
            },
            ".name": {
              "margin-top": "1rem"
            },
            "@media (min-width: 992px)": {
              ".nav-tabs": {
                "margin-right": "auto",
                "margin-left": "auto"
              },
              ".nav-tabs .nav-link": {
                "margin": "0 1rem",
                "padding": "1.5rem 2.5rem"
              },
              ".tab-content": {
                "padding": "3.5rem"
              },
              ".left-column": {
                "padding-right": "4rem"
              },
              ".right-column": {
                "padding-left": "4rem"
              }
            },
            "@media (max-width: 991px)": {
              ".tab-content": {
                "padding": "1rem"
              },
              ".nav-item": {
                "padding": "0.5rem"
              },
              ".card-img": {
                "margin-top": "0.6rem"
              },
              ".card-img2": {
                "margin-bottom": "1.5rem"
              }
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".nav-tabs": {
                "padding": "0",
                "display": "flex",
                "justify-content": "space-between"
              },
              ".nav-item": {
                "padding": "0"
              },
              ".last-navitem": {
                "width": "100%"
              },
              "li": {
                "width": "140px"
              },
              ".container-fluid": {
                "padding": "0"
              },
              ".nav-link": {
                "margin-bottom": "1rem !important"
              },
              ".mbr-iconfont": {
                "margin-top": "0.4rem"
              }
            },
            ".mbr-section-title": {
              "color": "#0a1c44"
            }
          },
          "_customHTML": "<section class=\"tabs3 kidsm4_tabs3 tabs\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" group=\"Accordion & Toggles & Tabs\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input inline max=\"15\" min=\"0\" name=\"paddingTop\" step=\"1\" title=\"Top\" type=\"range\" value=\"6\">\n\t\t<input inline max=\"15\" min=\"0\" name=\"paddingBottom\" step=\"1\" title=\"Bottom\" type=\"range\" value=\"5\">\n\t\t<header>Show/Hide</header>\n\t\t<input name=\"showTitle\" title=\"Title\" type=\"checkbox\" checked>\n\t\t<input name=\"showSubtitle\" title=\"Subtitle\" type=\"checkbox\" checked>\n\t\t<header>Tab</header>\n\t\t<select name=\"bootstrapTabs\" title=\"Tabs Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t</select> <input name=\"tabColor\" title=\"Tab Color\" type=\"color\" value=\"#f4f8fa\">\n\t\t<input name=\"activeTabColor1\" title=\"Active Tab Color\" type=\"color\" value=\"#145b2c\">\n\t\t<input name=\"ColorBG\" title=\"Background\" type=\"color\" value=\"#ffffff\">\n\t\t<input checked name=\"showTitleTab\" title=\"Title\" type=\"checkbox\">\n\t\t<input checked name=\"showImages\" title=\"Image\" type=\"checkbox\">\n\t\t<select name=\"itemsCount\" title=\"Items Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset name=\"bg\" parallax type=\"background\">\n\t\t\t<input parallax title=\"Image\" type=\"image\" value>\n\t\t\t<input selected title=\"Color\" type=\"color\" value=\"#ffffff\">\n\t\t\t<input title=\"Video\" type=\"video\" value=\"https://vimeo.com/201169087\">\n\t\t</fieldset>\n\t\t<input checked condition=\"bg.type=='color'\" name=\"gradientBg\" title=\"Gradient\" type=\"checkbox\">\n\t\t<input condition=\"gradientBg && bg.type == 'color'\" name=\"color2\" title=\"Color 2\" type=\"color\" value=\"#ffffff\">\n\n\t\t<input checked condition=\"bg.type !== 'color'\" name=\"overlay\" title=\"Overlay\" type=\"checkbox\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" name=\"overlayColor\" title=\"Overlay Color\" type=\"color\" value=\"#ffffff\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" inline max=\"1\" min=\"0\" name=\"overlayOpacity\" step=\"0.1\" title=\"Opacity\" type=\"range\" value=\"0.7\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<h2 class=\"mbr-section-title align-center mbr-fonts-style pb-3\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\"><b>\n\t\t\tNivel Secundario</b></h2>\n\t\t<h3 class=\"mbr-section-subtitle align-center mbr-light mbr-fonts-style pb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\">\n\t\t\tEl Nivel Secundario del CECIEMA abarca de 1° a 5° año, en el turno mañana.</h3>\n\t\t<div class=\"media-container-row\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<ul class=\"nav nav-tabs\" data-app-placeholder=\"Type Title\" role=\"tablist\">\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab1-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style show active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-1c_tab0\" role=\"tab\"><span class=\"mbrib-home mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Edificio</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 2\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab2-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-1c_tab1\" role=\"tab\"><span class=\"mobi-mbri mobi-mbri-like mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Propuesta</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 2\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab3-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-1c_tab2\" role=\"tab\"><span class=\"mbrib-drag-n-drop mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Trabajo</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 3\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab4-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-1c_tab3\" role=\"tab\"><span class=\"mbri-calendar mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<span class=\"name\">Desafíos</span> </a></li>\n\t\t\t\t\t<li class=\"nav-item last-navitem\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 4\" mbr-theme-style=\"display-5\"><a aria-controls=\"#kids3-tab5-content\" aria-selected=\"true\" class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs3-n_tab4\" role=\"tab\">\n\t\t\t\t\t\t\t<span class=\"mbrib-star mbr-iconfont mbr-iconfont-btn\"></span>\n\t\t\t\t\t\t\t<span class=\"name\">Holidays</span> </a></li>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"tab-content\">\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab1\" class=\"tab-pane active\" id=\"kids3-tab1-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tNuevo edificio</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Se inauguró la 2°planta del nuevo edificio para el Nivel Secundario. Con instalaciones nuevas y&nbsp; equipamiento a estrenar.</p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tAulas nuevas</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tPatio abierto y techado</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Nuevos sanitarios y vestuarios</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/dsc-4782-998x662.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab2\" class=\"tab-pane\" id=\"kids3-tab2-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img card-img2\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/-dsc5766-998x665.jpeg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"right-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tPropuesta educativa</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Con orientación en Informática, se promueve el pensamiento lógico computacional, la programación y multimedia.</p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Informática</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Programación</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Multimedia</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab3\" class=\"tab-pane\" id=\"kids3-tab3-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tTrabajo en Equipo</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tSe realiza a través de un sistema de estímulo que favorece el desarrollo de capacidades colaborativas, responsabilidad y autogestión.</p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Trabajo Colaborativo</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tAutogestión</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tAutonomía</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/-dsc5578-998x665.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab4\" class=\"tab-pane\" id=\"kids3-tab4-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tDesafíos</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tAprendizaje basado en Proyectos, en retos y<br> desafíos que promuevan la creatividad, la <br>superación de límites y el logro de metas.</p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Charlas con expertos</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">Preparación para la Universidad</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"@PROJECT_PATH@/assets/images/images-80x80.png\" alt>\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tPreparación para el Trabajo</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/-dsc5562-998x665.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div aria-labelledby=\"kids3-tab5\" class=\"tab-pane\" id=\"kids3-tab5-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"left-column\" mbr-class=\"{'col-lg-6':showImages,'col-md-12':!showImages}\">\n\t\t\t\t\t\t\t\t<h4 class=\"display-2 title-content pb-2 mbr-fonts-style\" data-app-selector=\".title-content\" mbr-if=\"showTitleTab\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet </h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit. Autem laudantium in adipisci ipsa optio quas id excepturi non, eos cupiditate </p>\n\t\t\t\t\t\t\t\t<div mbr-list mbr-list-grow=\"itemsCount\">\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"false\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tOutdoor Activity </h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"false\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tDrawing Course </h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t\t\t<img class=\"icon-img\" src=\"false\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .wrapper\" mbr-if mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\tPlayground </h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-lg-6\" mbr-if=\"showImages\">\n\t\t\t\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t\t\t\t<img alt class=\"right-img\" src=\"@PROJECT_PATH@/assets/images/gallery06.jpg\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
